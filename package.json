{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal developer portfolio built with Astro and published on GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images": "node --disable-warning=ExperimentalWarning scripts/generate-images.mjs",
    "cv:pdf": "node --disable-warning=ExperimentalWarning scripts/build-cv-pdf.mjs",
    "placeholders": "node --disable-warning=ExperimentalWarning scripts/check-placeholders.mjs",
    "test:links": "linkinator dist --recurse --check-fragments --skip \"^https?://(?!(localhost|127\\.0\\.0\\.1)(?!:4321))\" --verbosity error",
    "test:a11y": "playwright test",
    "test:lighthouse": "lhci autorun",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build && npm run test:links && npm run test:a11y"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "fontkit": "2.0.4",
    "globals": "17.13.0",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
