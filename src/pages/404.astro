---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="not-found container" aria-labelledby="not-found-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="not-found-title">Page not found</h1>
    <p class="not-found__text">
      The page you were looking for has moved or never existed. Try the home page or the projects instead.
    </p>
    <div class="not-found__links">
      <a class="btn btn--primary" href={withBase('/')}>
        <Icon name="arrow-left" size={16} />
        Back to the home page
      </a>
      <a class="btn btn--secondary" href={withBase('/#projects')}>
        View projects
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 14vw, 9rem);
  }

  .not-found__text {
    max-width: 52ch;
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }
</style>
