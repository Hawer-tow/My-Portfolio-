---
/** One gallery thumbnail: links to the full-size image, which the lightbox opens when JavaScript runs. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  slide: {
    src: ImageMetadata;
    alt: string;
    caption: string;
    full: string;
    shape: 'portrait' | 'landscape' | 'wide';
  };
  /** True when the whole group is phone screenshots (tall frames, narrower columns). */
  portraitGroup: boolean;
}

const { slide, portraitGroup } = Astro.props;
---

<li class="gallery__item" data-reveal>
  <figure>
    <a
      class="gallery__link"
      href={slide.full}
      data-lightbox-item
      data-caption={slide.caption}
      data-alt={slide.alt}
    >
      <Picture
        src={slide.src}
        alt={slide.alt}
        formats={['avif', 'webp']}
        widths={slide.shape === 'portrait' ? [240, 360, 480] : [400, 640, 800]}
        sizes={
          portraitGroup
            ? '(min-width: 70rem) 200px, (min-width: 40rem) 30vw, 45vw'
            : '(min-width: 70rem) 350px, (min-width: 40rem) 45vw, calc(100vw - 2rem)'
        }
        class:list={['gallery__image', `gallery__image--${slide.shape}`]}
      />
      <span class="visually-hidden">(open larger image)</span>
    </a>
    <figcaption class="gallery__caption">{slide.caption}</figcaption>
  </figure>
</li>
