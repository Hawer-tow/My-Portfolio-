---
/** Social links as icon-and-label pairs. Links that are not filled in are not rendered. */
import { getSocialLinks } from '../lib/socials';
import Icon from './Icon.astro';

interface Props {
  class?: string;
  /** Compact layout for the footer. */
  compact?: boolean;
}

const { class: className, compact = false } = Astro.props;
const links = getSocialLinks();
---

{links.length > 0 && (
  <ul class:list={['social-links', { 'social-links--compact': compact }, className]}>
    {links.map((link) => (
      <li>
        <a href={link.href} rel="me noopener">
          <Icon name={link.icon} size={18} />
          <span>{link.label}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-links li {
    margin: 0;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2.75rem;
    color: var(--text);
    text-decoration: none;
  }

  .social-links a:hover {
    color: var(--accent);
  }

  .social-links a:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .social-links--compact a {
    min-height: 2.25rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
