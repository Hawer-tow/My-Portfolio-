---
import { Picture } from 'astro:assets';
import { isFilled } from '../lib/placeholders';
import { projectHref, type Project } from '../lib/projects';
import Icon from './Icon.astro';
import TagList from './TagList.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const titleId = `project-${project.id}-title`;
---

<article class="project-card card" aria-labelledby={titleId} data-areas={data.areas.join(' ')} data-reveal>
  <Picture
    src={data.cover}
    alt=""
    formats={['avif', 'webp']}
    widths={[400, 600, 800]}
    sizes="(min-width: 70rem) 350px, (min-width: 40rem) 45vw, calc(100vw - 2rem)"
    class="project-card__image"
  />
  <div class="project-card__body">
    <p class="project-card__areas">
      {data.areas.join(' · ')}
      {data.draft && <span class="badge">Draft</span>}
    </p>
    <h3 id={titleId} class="project-card__title">
      <a href={projectHref(project)} class="project-card__link">
        {data.title}
      </a>
    </h3>
    <p class="project-card__summary">{data.summary}</p>
    <TagList tags={data.stack.slice(0, 5)} label={`Technologies used in ${data.title}`} />
    {isFilled(data.links.demo) && (
      <p class="project-card__extra">
        <a href={data.links.demo} class="link-arrow">
          Visit the live site
          <Icon name="external-link" size={15} />
        </a>
      </p>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project-card :global(.project-card__image) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .project-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m);
  }

  .project-card__body > * {
    margin: 0;
  }

  .project-card__areas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .project-card__title {
    font-size: var(--step-1);
  }

  .project-card__link {
    color: var(--text);
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .project-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .project-card__link:focus-visible {
    outline: none;
  }

  .project-card__link:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .project-card:hover .project-card__link {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .project-card__summary {
    color: var(--text-muted);
  }

  /* Secondary links sit above the stretched title link. */
  .project-card__extra {
    position: relative;
    z-index: 1;
    margin-top: auto;
  }
</style>
