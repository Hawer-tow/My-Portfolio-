---
/** Email shown as text, with a mailto link and a copy-to-clipboard button (JavaScript only). */
import Icon from './Icon.astro';

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="copy-email">
  <a class="copy-email__address" href={`mailto:${email}`}>
    <Icon name="mail" size={20} />
    <span>{email}</span>
  </a>
  <button type="button" class="btn btn--secondary btn--small js-only" data-copy-email={email}>
    <Icon name="copy" size={16} class="copy-email__icon-copy" />
    <Icon name="check" size={16} class="copy-email__icon-done" />
    <span data-copy-label>Copy email</span>
  </button>
  <span class="visually-hidden" aria-live="polite" data-copy-status></span>
</div>

<style>
  .copy-email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }

  .copy-email__address {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2.75rem;
    font-size: var(--step-1);
    font-weight: 600;
    word-break: break-all;
  }

  .copy-email :global(.copy-email__icon-done),
  .copy-email .is-copied :global(.copy-email__icon-copy) {
    display: none;
  }

  .copy-email .is-copied :global(.copy-email__icon-done) {
    display: inline-block;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');

    button.addEventListener('click', async () => {
      let message = 'Email address copied';
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        button.classList.add('is-copied');
        if (label) label.textContent = 'Copied';
      } catch {
        message = 'Could not copy. Please select the address instead.';
      }
      if (status) status.textContent = message;
      setTimeout(() => {
        button.classList.remove('is-copied');
        if (label) label.textContent = 'Copy email';
        if (status) status.textContent = '';
      }, 2500);
    });
  });
</script>
