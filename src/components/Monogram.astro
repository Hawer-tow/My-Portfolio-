---
/**
 * Typographic monogram from the initials of site.fullName.
 * The favicon and social image use the same design (generated by `npm run images`).
 */
import { site } from '../config/site';
import { initials } from '../lib/initials';

interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
const letters = initials(site.fullName);
---

<svg
  class:list={['monogram', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect class="monogram__bg" x="0" y="0" width="64" height="64" rx="10"></rect>
  <text class="monogram__text" x="32" y="43" text-anchor="middle">
    {letters}
  </text>
</svg>

<style>
  .monogram__bg {
    fill: var(--accent);
  }

  .monogram__text {
    fill: var(--accent-contrast);
    font-family: var(--font-serif);
    font-size: 29px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }
</style>
