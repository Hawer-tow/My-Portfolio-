---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/print.css';
import Fonts from '../components/Fonts.astro';
import Seo, { type SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavKey } from '../lib/nav';

interface Props extends SeoProps {
  /** Highlights the matching navigation item. */
  current?: NavKey;
}

const { current, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Apply the stored or system theme before first paint, so the wrong theme never flashes. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') root.setAttribute('data-theme', stored);
        } catch {
          // Storage unavailable: the system theme applies.
        }
      })();
    </script>
    <Fonts />
    <Seo {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
